import csv
import numpy as np
import matplotlib.pyplot as plt


plt.rcParams.update({
    "text.usetex": True,
    "font.family": "serif",
    "font.serif": ["Latin Modern Roman"],
    "font.size": 28,
    "axes.labelsize": 28,
    "legend.fontsize": 28
})


def read_csv(filename):
    """
    Read mesh size and L2 error data from a CSV file.

    Parameters
    ----------
    filename : str
        Name of the CSV file containing columns ``h`` and ``L2``.

    Returns
    -------
    tuple[numpy.ndarray, numpy.ndarray]
        Mesh sizes and corresponding L2 errors.
    """
    h, err = [], []
    with open(filename, "r") as f:
        reader = csv.DictReader(f)
        for row in reader:
            h.append(float(row["h"]))
            err.append(float(row["L2"]))
    return np.array(h), np.array(err)


h1, e1 = read_csv("trig_pe1.csv")
h2, e2 = read_csv("trig_pe2.csv")

idx1 = np.argsort(h1)[::-1]
idx2 = np.argsort(h2)[::-1]

h1, e1 = h1[idx1], e1[idx1]
h2, e2 = h2[idx2], e2[idx2]

plt.figure(figsize=(8,6))

plt.loglog(h1, e1, 'o-', label=r'Trig., $P_e=1$')
plt.loglog(h2, e2, 's-', label=r'Trig., $P_e=2$')

h_ref = np.linspace(min(h2), max(h2), 100)

ref2 = e1[-1] * (h_ref / h1[-1])**2
plt.loglog(h_ref, ref2, '--', label=r'$O(h^2)$')

ref3 = e2[-1] * (h_ref / h2[-1])**3
plt.loglog(h_ref, ref3, '--', label=r'$O(h^3)$')

plt.gca().invert_xaxis()
plt.xlabel(r'$h$')
plt.ylabel(r'$L^2$-error')
plt.legend()
plt.grid(True, which="major", linestyle="--", linewidth=0.5)

plt.tight_layout()
plt.show()